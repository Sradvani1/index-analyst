# Provider selection
# SPX_LLM_PROVIDER=google      # google (default) | anthropic | openai

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
SPX_MODEL=claude-opus-5
SPX_PROMPT_CACHE_ENABLED=true

# OpenAI — optional research assistant chat and analytical pipeline
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_CHAT_MODEL=gpt-5
# SPX_OPENAI_PIPELINE_MODEL=gpt-5.6-sol  # defaults to gpt-5.6-sol if unset
# Optional: base instructions file for runtime preload (build_additional_instructions)
# SPX_CHAT_ASSISTANT_INSTRUCTIONS_PATH=framework/chat-assistant-instructions.md

# Google AI Studio Gemini — default analytical and Substack pipeline
# GOOGLE_API_KEY=AIza...
# SPX_GOOGLE_PIPELINE_MODEL=gemini-3.7-flash
# SPX_GOOGLE_THINKING_LEVEL=HIGH  # optional shared Pass 1/2 override
# Pass 1 defaults to HIGH and Pass 2 defaults to Gemini thinking when these overrides are unset.
# SPX_GOOGLE_STATE_THINKING_LEVEL=HIGH  # Pass 1 override
# SPX_GOOGLE_REPORT_THINKING_LEVEL=LOW  # overrides the shared level for Pass 2
# SPX_GOOGLE_MAX_OUTPUT_TOKENS=16000
# SPX_GOOGLE_SUBSTACK_MAX_OUTPUT_TOKENS=8000
# SPX_GOOGLE_PODCAST_MAX_OUTPUT_TOKENS=4000
# SPX_GOOGLE_TTS_MODEL=gemini-3.1-flash-tts-preview
# SPX_PODCAST_VOICE=Orus

# EPS master history: data/master/eps_history.json (forward_eps, trailing_eps per effective_from).
# SPX, VIX, and 10Y for precompute are fetched via yfinance at run time.
# StreetStats EPS sync uses a public guest-token flow; no API key is required.
# SPX_STREETSTATS_BASE_URL=https://streetstats.finance
# SPX_STREETSTATS_TIMEOUT_SECONDS=30

# Memory / run tuning
SPX_RECENT_STATE_COUNT=6
SPX_IMAGE_MAX_DIMENSION=1568
SPX_PASS2_IMAGE_OPTIMIZATION=true
SPX_PASS2_IMAGE_MAX_DIMENSION=1092
SPX_MAX_REPORT_CHARS=24000
SPX_INCLUDE_MEMORY=false

# Paths (defaults resolve relative to the package root)
# SPX_FRAMEWORK_PATH=framework/SPX-Daily-Analysis-Framework.md
# SPX_ROLE_PATH=framework/SPX-Claude-Role-Block.md
# SPX_DATA_DIR=data
# SPX_EPS_HISTORY_PATH=data/master/eps_history.json
# SPX_MEMORY_DIR=memory
# SPX_OUTPUT_DIR=output
# SPX_DAILY_PDFS_DIR=daily_pdfs
